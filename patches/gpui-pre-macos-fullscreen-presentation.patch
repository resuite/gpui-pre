+fn native_fullscreen_presentation_options(proposed_options: NSUInteger) -> NSUInteger {
+    // A hosted NSApplication can inherit fullscreen presentation options from
+    // its executable host. Native macOS fullscreen should auto-hide the menu
+    // bar and Dock rather than disabling them entirely, so both can reveal at
+    // the screen edge as AppKit intends.
+    let options = proposed_options
+        & !(NS_APPLICATION_PRESENTATION_HIDE_DOCK | NS_APPLICATION_PRESENTATION_HIDE_MENU_BAR);
+    options
+        | NS_APPLICATION_PRESENTATION_FULL_SCREEN
+        | NS_APPLICATION_PRESENTATION_AUTO_HIDE_DOCK
+        | NS_APPLICATION_PRESENTATION_AUTO_HIDE_MENU_BAR
+}
+
+extern "C" fn window_will_use_fullscreen_presentation_options(
+    _: &Object,
+    _: Sel,
+    _: id,
+    proposed_options: NSUInteger,
+) -> NSUInteger {
+    native_fullscreen_presentation_options(proposed_options)
+}
+
 extern "C" fn window_will_exit_fullscreen(this: &Object, _: Sel, _: id) {
     let window_state = unsafe { get_window_state(this) };
     let lock = window_state.as_ref().lock();
@@ -3585,4 +3615,20 @@ mod tests {
     fn display_id_for_screen_returns_none_for_null_screen() {
         assert_eq!(display_id_for_screen(nil), None);
     }
+
+    #[test]
+    fn native_fullscreen_keeps_menu_bar_and_dock_revealable() {
+        let host_options = NS_APPLICATION_PRESENTATION_HIDE_DOCK
+            | NS_APPLICATION_PRESENTATION_HIDE_MENU_BAR;
+        let options = native_fullscreen_presentation_options(host_options);
+
+        assert_eq!(options & NS_APPLICATION_PRESENTATION_HIDE_DOCK, 0);
+        assert_eq!(options & NS_APPLICATION_PRESENTATION_HIDE_MENU_BAR, 0);
+        assert_ne!(options & NS_APPLICATION_PRESENTATION_FULL_SCREEN, 0);
+        assert_ne!(options & NS_APPLICATION_PRESENTATION_AUTO_HIDE_DOCK, 0);
+        assert_ne!(
+            options & NS_APPLICATION_PRESENTATION_AUTO_HIDE_MENU_BAR,
+            0
+        );
+    }
